# kind-3node.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: krishna-cluster
nodes:
  - role: control-plane
    image: ssh-node:v1.34.0
    extraPortMappings:
      - containerPort: 22
        hostPort: 2222
  - role: worker
    image: ssh-node:v1.34.0
    extraPortMappings:
      - containerPort: 22
        hostPort: 2223
  - role: worker
    image: ssh-node:v1.34.0
    extraPortMappings:
      - containerPort: 22
        hostPort: 2224
  - role: worker
    image: ssh-node:v1.34.0
    extraPortMappings:
      - containerPort: 22
        hostPort: 2225